# ==============================================================================
# IoT Incident Response (IIR) Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your values:
#   copy .env.example .env     (Windows PowerShell / CMD)
#   cp .env.example .env       (Linux / macOS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM REASONING MODE (Toggle between Gemini and Normal/Mock modes)
# ------------------------------------------------------------------------------
# Choose LLM mode:
#   - "mock"   : NORMAL / OFFLINE MODE (Default)
#                Zero cost, runs 100% offline using deterministic local agent responses.
#                No API key or internet required.
#   - "gemini" : LIVE GEMINI API MODE
#                Connects live to Google Gemini models for real-time diagnostic reasoning.
LLM_PROVIDER=mock

# Model name:
#   - If LLM_PROVIDER=mock   : "mock-model"
#   - If LLM_PROVIDER=gemini : "gemini-3.8-flash", "gemini-1.5-flash", or "gemini-1.5-pro"
LLM_MODEL=gemini-3.8-flash

# Google Gemini API Key:
#   - Required ONLY when LLM_PROVIDER=gemini
#   - Get your free key at: https://aistudio.google.com/
#   - Keep this private; NEVER commit your real key to version control!
LLM_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & SECURITY
# ------------------------------------------------------------------------------
# Runtime environment: "development", "test", or "production"
# (When set to "production", interactive OpenAPI /docs are automatically disabled)
APP_ENV=development

# Cryptographic pepper for API key hashing (minimum 32 random characters in production)
API_KEY_PEPPER=placeholder_pepper_secret_min_32_chars


# ------------------------------------------------------------------------------
# 3. MQTT MESSAGE BROKER SETTINGS
# ------------------------------------------------------------------------------
# Broker hostname (Local: localhost, Docker / Remote: broker.example.com)
MQTT_HOST=localhost

# Broker port (Plain: 1883, Production TLS: 8883)
MQTT_PORT=1883

# MQTT authentication credentials
MQTT_USERNAME=simulator
MQTT_PASSWORD=placeholder_mqtt_password

# Enable TLS encryption for MQTT (false for local development, true for production)
MQTT_TLS=false


# ------------------------------------------------------------------------------
# 4. FRONTEND DASHBOARD SETTINGS (Optional overrides)
# ------------------------------------------------------------------------------
# API URL that the Streamlit dashboard connects to
API_BASE_URL=http://127.0.0.1:8000/v1

# Operator API Key (Generated via: python scripts/create_key.py --role approver --label "Admin")
IIR_API_KEY=
