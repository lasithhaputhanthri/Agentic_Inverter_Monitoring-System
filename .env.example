# Broker hostname for MQTT fleet telemetry (Local: localhost, Production: broker.example.com)
MQTT_HOST=localhost

# Broker port for MQTT telemetry (Local dev: 1883, Production TLS: 8883)
MQTT_PORT=1883

# MQTT username for authentication (from Mosquitto password file / ACL)
MQTT_USERNAME=simulator

# MQTT password for authentication (generated via make broker-users / local broker setup)
MQTT_PASSWORD=placeholder_mqtt_password

# Whether to enable TLS for MQTT connections (false for local dev, true for production SEC-51)
MQTT_TLS=false

# Pepper secret used for hashing API keys (from internal secret manager / ops team)
API_KEY_PEPPER=placeholder_pepper_secret_min_32_chars

# LLM provider name (e.g. mock, openai, anthropic, google)
LLM_PROVIDER=mock

# LLM model identifier (e.g. gpt-4o, claude-3-5-sonnet, gemini-1.5-pro)
LLM_MODEL=mock-model

# LLM provider API key (from provider developer console - never committed!)
LLM_API_KEY=placeholder_llm_api_key

# Application runtime environment (development, test, production)
APP_ENV=development
